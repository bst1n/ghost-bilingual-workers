{
  // Ghost i18n cross-linking Worker.
  // Intercepts HTML on both FR and EN Ghost blogs, injects hreflang tags
  // and a translation notice. Also handles 301 redirect from the EN subdomain
  // (en.your-blog.com/*) to the public subdirectory URL (your-blog.com/en/*).
  //
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghost-subdir-i18n",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "observability": { "enabled": true },
  "vars": {
    // FR Ghost blog — the reference/primary language.
    "FR_SITE_URL": "https://your-blog.com",
    // EN Ghost blog — Ghost's configured site URL (en subdomain).
    "EN_SITE_URL": "https://en.your-blog.com",
    // Public URL of the EN content as visible to readers (subdirectory mount).
    "EN_PUBLIC_URL": "https://your-blog.com/en",
    // workers.dev URL of the api-proxy-worker (see ../api-proxy-worker/).
    "API_PROXY_URL": "https://ghost-subdir-i18n-api-proxy.your-account.workers.dev"
  },
  // Routes attach the Worker to both the FR and EN domains.
  // If en.your-blog.com is a subdomain inside the your-blog.com Cloudflare zone,
  // set both zone_name values to "your-blog.com".
  // If it lives in its own zone, adjust the second zone_name accordingly.
  "routes": [
    { "pattern": "your-blog.com/*", "zone_name": "your-blog.com" },
    { "pattern": "en.your-blog.com/*", "zone_name": "your-blog.com" }
  ]
  // Secrets (set via `wrangler secret put`):
  //   PROXY_SHARED_SECRET     — shared with api-proxy-worker
  //   INTERNAL_BYPASS_SECRET  — shared with subdir-fetcher-worker
}
